                          "width": "var(--container-widget-width,84%)",
                          "max-width": "84%",
                          "--container-widget-width": "84%",
                          "padding": "0% 10% 0% 10%"
                        }
                      },
                      "type": "text",
                      "html": "<p>When potential buyers make offers to purchase (also called an Ontario Agreement of Purchase and Sale), Nava Wilson real estate lawyers can review the legal details to ensure it’s right for you. We advise you on real estate deposits, seller’s rights and obligations, and legal options if buyers withdraw offers. Lawyers manage the legal formalities involved in finalizing real estate deals in Ontario.</p>"
                    }
                  ]
                }
              ]
            }
          ]
        }

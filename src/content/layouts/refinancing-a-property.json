                          "width": "var(--container-widget-width,65%)",
                          "max-width": "65%",
                          "--container-widget-width": "65%"
                        }
                      },
                      "type": "text",
                      "html": "<p>Nava Wilson real estate lawyers collaborate with both individual and business clients to secure and facilitate financing for commercial and residential properties. By conducting thorough document reviews and meticulous preparation, we guarantee the protection of our clients’ interests throughout the entire process.</p>"

                  "font-size": "16px",
                  "font-weight": "600"
                }
              },
              "type": "text",
              "html": "When refinancing or securing a mortgage on a property, the firm will handle the following:"
            },
            {
              "id": "f95a588",
              "hide": [],
              "cls": [],
              "style": {
                "listIcon": {
                  "fill": "#585858"
                },
                "self": {
                  "padding": "0% 15% 0% 0%"
                }
              },
              "type": "icon-list",
              "items": [
                {
                  "text": "Complete necessary searches, including title searches and PPSA searches;",
                  "icon": {
                    "svg": "<svg aria-hidden=\"true\" class=\"e-font-icon-svg e-fas-circle\" viewBox=\"0 0 512 512\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M256 8C119 8 8 119 8 256s111 248 248 248 248-111 248-248S393 8 256 8z\"></path></svg>"
                  }
                },
                {
                  "text": "Arrange to payout balances owing on any existing financing to be paid from the proceeds;",
                  "icon": {
                    "svg": "<svg aria-hidden=\"true\" class=\"e-font-icon-svg e-fas-circle\" viewBox=\"0 0 512 512\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M256 8C119 8 8 119 8 256s111 248 248 248 248-111 248-248S393 8 256 8z\"></path></svg>"
                  }
                }
              ]
            },
            {
              "id": "09c6f09",
              "hide": [],
              "cls": [],
              "style": {
                "listIcon": {
                  "fill": "#585858"
                }
              },
              "type": "icon-list",
              "items": [
                {
                  "text": "Prepare and review all documentation;",
                  "icon": {
                    "svg": "<svg aria-hidden=\"true\" class=\"e-font-icon-svg e-fas-circle\" viewBox=\"0 0 512 512\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M256 8C119 8 8 119 8 256s111 248 248 248 248-111 248-248S393 8 256 8z\"></path></svg>"
                  }
                },
                {
                  "text": "Register the mortgage on title.",
                  "icon": {
                    "svg": "<svg aria-hidden=\"true\" class=\"e-font-icon-svg e-fas-circle\" viewBox=\"0 0 512 512\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M256 8C119 8 8 119 8 256s111 248 248 248 248-111 248-248S393 8 256 8z\"></path></svg>"
                  }
                }
              ]

---
import { Image } from 'astro:assets';
import logo from '../assets/logos/navawilson.png';
import {
  ADDRESS_LINES, EMAIL, FAX, FIRM_NAME, FOOTER_RESOURCES, FOOTER_SERVICES, MAP_URL, PHONE, PHONE_HREF, SOCIALS,
} from '../data/site';

// Tabler Icons (MIT), filled.
const icons = {
  pin: 'M18.364 4.636a9 9 0 0 1 .203 12.519l-.203 .21l-4.243 4.242a3 3 0 0 1 -4.097 .135l-.144 -.135l-4.244 -4.243a9 9 0 0 1 12.728 -12.728zm-6.364 3.364a3 3 0 1 0 0 6a3 3 0 0 0 0 -6z',
  phone: 'M9 3a1 1 0 0 1 .877 .519l.051 .11l2 5a1 1 0 0 1 -.313 1.16l-.1 .068l-1.674 1.004l.063 .103a10 10 0 0 0 3.132 3.132l.102 .062l1.005 -1.672a1 1 0 0 1 1.113 -.453l.115 .039l5 2a1 1 0 0 1 .622 .807l.007 .121v4c0 1.657 -1.343 3 -3.06 2.998c-8.579 -.521 -15.418 -7.36 -15.94 -15.998a3 3 0 0 1 2.824 -2.995l.176 -.005h4z',
  fax: 'M17 2a1 1 0 0 1 1 1v4h1a3 3 0 0 1 3 3v6a3 3 0 0 1 -3 3h-1v2a1 1 0 0 1 -1 1h-10a1 1 0 0 1 -1 -1v-2h-1a3 3 0 0 1 -3 -3v-6a3 3 0 0 1 3 -3h1v-4a1 1 0 0 1 1 -1zm-1 13h-8v5h8zm0 -11h-8v3h8z',
  mail: 'M22 7.535v9.465a3 3 0 0 1 -2.824 2.995l-.176 .005h-14a3 3 0 0 1 -2.995 -2.824l-.005 -.176v-9.465l9.445 6.297l.116 .066a1 1 0 0 0 .878 0l.116 -.066l9.445 -6.297z M19 4c1.08 0 2.027 .57 2.555 1.427l-9.555 6.37l-9.555 -6.37a2.999 2.999 0 0 1 2.354 -1.42l.201 -.007h14z',
};
const contact = [
  { icon: icons.pin, label: ADDRESS_LINES.join(' '), href: MAP_URL, external: true },
  { icon: icons.phone, label: PHONE, href: PHONE_HREF },
  { icon: icons.fax, label: FAX },
  { icon: icons.mail, label: EMAIL, href: `mailto:${EMAIL}` },
];
---

<footer class="footer">
  <div class="container footer__grid">
    <div class="footer__brand">
      <Image src={logo} alt="Nava Wilson Professional Corporation" width={200} densities={[1, 2]} />
      <p>{FIRM_NAME} specializes in Real Estate, Corporate Law, Litigation, and Wills and Estates.</p>
      <ul class="socials">
        {SOCIALS.map((s) => (
          <li>
            <a href={s.href} aria-label={s.label} target="_blank" rel="noopener">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={s.path} /></svg>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <h2>Services</h2>
      <ul class="links">{FOOTER_SERVICES.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
    </div>

    <div>
      <h2>Resources</h2>
      <ul class="links">{FOOTER_RESOURCES.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
    </div>

    <div>
      <h2>CONTACT US</h2>
      <ul class="contact">
        {contact.map((c) => (
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={c.icon} /></svg>
            {c.href ? <a href={c.href} target={c.external ? '_blank' : undefined} rel={c.external ? 'noopener' : undefined}>{c.label}</a> : <span>{c.label}</span>}
          </li>
        ))}
      </ul>
    </div>
  </div>
  <p class="container copyright">© {new Date().getFullYear()} Nava Wilson Professional Corporation. All rights reserved.</p>
</footer>

<style>
  .footer {
    padding-block: 48px 32px;
    font-size: 15px;
    color: var(--color-text);
  }

  .footer__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) repeat(3, minmax(0, 1fr));
    gap: 40px;
  }

  .footer__brand p {
    margin-top: 20px;
    max-width: 280px;
  }

  h2 {
    margin-bottom: 16px;
    font-size: 17px;
    letter-spacing: 0.06em;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .links li + li,
  .contact li + li {
    margin-top: 8px;
  }

  a {
    text-decoration: none;
  }

  a:hover {
    color: var(--color-primary);
  }

  .contact li {
    display: flex;
    gap: 10px;
  }

  .contact svg {
    flex: none;
    margin-top: 3px;
    color: var(--color-primary);
  }

  .socials {
    display: flex;
    gap: 12px;
    margin-top: 20px;
    color: var(--color-primary);
  }

  .socials a:hover {
    opacity: 0.7;
  }


  .copyright {
    margin-top: 40px;
    padding-top: 20px;
    border-top: 1px solid var(--color-border);
    font-size: 14px;
    color: var(--color-text-muted);
    text-align: center;
  }

  @media (max-width: 900px) {
    .footer__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .footer__brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 480px) {
    .footer__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

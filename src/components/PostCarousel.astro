---
import { getCollection } from 'astro:content';
import PostCard from './PostCard.astro';

interface Props {
  slugs: string[];
}

const all = await getCollection('blog');
const posts = Astro.props.slugs.map((slug) => all.find((p) => p.id === slug)).filter((p) => p !== undefined);
---

<div class="carousel">
  <button type="button" class="arrow prev" aria-label="Previous articles">‹</button>
  <ul class="track">{posts.map((post) => <li><PostCard post={post} /></li>)}</ul>
  <button type="button" class="arrow next" aria-label="Next articles">›</button>
</div>

<script>
  // Loops like the live Elementor carousel: the first card moves to the end (or back), then autoplays every 5s.
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

  for (const carousel of document.querySelectorAll<HTMLElement>('.carousel')) {
    const track = carousel.querySelector<HTMLElement>('.track')!;
    const items = () => [...track.children] as HTMLElement[];
    const shift = () => {
      const [a, b] = items();
      return b ? b.getBoundingClientRect().left - a.getBoundingClientRect().left : 0;
    };
    let busy = false;

    const slide = (from: number, to: number) =>
      Promise.all(items().map((li) => li.animate(
        [{ transform: `translateX(${from}px)` }, { transform: `translateX(${to}px)` }],
        { duration: reduceMotion ? 0 : 450, easing: 'ease' },
      ).finished));

    const next = async () => {
      if (busy || items().length < 2) return;
      busy = true;
      track.scrollLeft = 0;
      await slide(0, -shift());
      track.append(items()[0]);
      busy = false;
    };

    const prev = async () => {
      if (busy || items().length < 2) return;
      busy = true;
      track.scrollLeft = 0;
      track.prepend(items().at(-1)!);
      await slide(-shift(), 0);
      busy = false;
    };

    carousel.querySelector('.prev')?.addEventListener('click', prev);
    carousel.querySelector('.next')?.addEventListener('click', next);

    let startX = 0;
    track.addEventListener('touchstart', (e) => (startX = e.touches[0].clientX), { passive: true });
    track.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 40) (dx < 0 ? next : prev)();
    });

    if (!reduceMotion) {
      let paused = false;
      carousel.addEventListener('mouseenter', () => (paused = true));
      carousel.addEventListener('mouseleave', () => (paused = false));
      carousel.addEventListener('focusin', () => (paused = true));
      carousel.addEventListener('focusout', () => (paused = false));
      carousel.addEventListener('touchstart', () => (paused = true), { passive: true });
      setInterval(() => !paused && !document.hidden && next(), 5000);
    }
  }
</script>

<style>
  .carousel {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 20px;
  }

  .track {
    list-style: none;
    display: flex;
    gap: 20px;
    flex: 1;
    min-width: 0;
    margin: 0;
    padding: 4px 4px 16px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .track li {
    flex: 0 0 calc((100% - 40px) / 3);
    scroll-snap-align: start;
  }

  .arrow {
    flex: none;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: 50%;
    background: var(--color-tint);
    color: var(--color-primary);
    font-size: 26px;
    line-height: 1;
    cursor: pointer;
  }

  .arrow:hover {
    background: #e2e2f0;
  }

  @media (max-width: 1023px) {
    .track li {
      flex-basis: calc((100% - 20px) / 2);
    }
  }

  @media (max-width: 600px) {
    .carousel {
      flex-wrap: wrap;
      justify-content: center;
    }
    .track {
      flex-basis: 100%;
      order: -1;
      overflow: hidden;
      touch-action: pan-y;
    }
    .track li {
      flex-basis: 100%;
    }
  }
</style>

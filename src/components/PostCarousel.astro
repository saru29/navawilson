---
import { getCollection } from 'astro:content';
import PostCard from './PostCard.astro';

interface Props {
  slugs: string[];
}

const all = await getCollection('blog');
const posts = Astro.props.slugs.map((slug) => all.find((p) => p.id === slug)).filter((p) => p !== undefined);
---

<div class="carousel">
  <button type="button" class="arrow prev" aria-label="Previous articles">‹</button>
  <ul class="track">{posts.map((post) => <li><PostCard post={post} /></li>)}</ul>
  <button type="button" class="arrow next" aria-label="Next articles">›</button>
</div>

<script>
  for (const carousel of document.querySelectorAll<HTMLElement>('.carousel')) {
    const track = carousel.querySelector<HTMLElement>('.track')!;
    const step = () => track.querySelector('li')?.getBoundingClientRect().width ?? track.clientWidth;
    carousel.querySelector('.prev')?.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
    carousel.querySelector('.next')?.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));
  }
</script>

<style>
  .carousel {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 32px;
  }

  .track {
    list-style: none;
    display: flex;
    gap: 20px;
    flex: 1;
    min-width: 0;
    margin: 0;
    padding: 4px 4px 16px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .track li {
    flex: 0 0 calc((100% - 40px) / 3);
    scroll-snap-align: start;
  }

  .arrow {
    flex: none;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: 50%;
    background: var(--color-tint);
    color: var(--color-primary);
    font-size: 26px;
    line-height: 1;
    cursor: pointer;
  }

  .arrow:hover {
    background: #e2e2f0;
  }

  @media (max-width: 1023px) {
    .track li {
      flex-basis: calc((100% - 20px) / 2);
    }
  }

  @media (max-width: 600px) {
    .track li {
      flex-basis: 85%;
    }
    .arrow {
      display: none;
    }
  }
</style>

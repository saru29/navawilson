---
import PostCarousel from '../PostCarousel.astro';

const slugs = [
  'why-title-insurance-is-essential-for-ontario-homebuyers',
  'lawyer-for-buying-pre-construction',
  'permanent-residence-pr-in-canada',
  'breach-of-real-estate-contracts',
  'mortgage-investment-corporations-in-ontario',
  'power-of-sale-process-ontario',
];
---

<section class="section">
  <div class="container">
    <div class="head">
      <h2 class="title">Featured<span>Insights</span></h2>
      <a href="/blogs/" class="btn">View All</a>
    </div>
    <PostCarousel slugs={slugs} />
  </div>
</section>

<style>
  .head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .head .btn {
    padding-inline: 44px;
  }

  @media (max-width: 600px) {
    .head {
      flex-direction: column;
    }
  }
</style>

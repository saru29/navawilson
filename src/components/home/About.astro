---
const facts = [
  'Top 10 Real Estate Law Firm in Ontario by First Canadian Title Insurance (FCT) through the past decade.',
  'Managing Partner, Kubes, serves on FCT Advisory Council and received the Homes Magazine Annual Awards for Who’s Who of Home Building Industry for two years.',
  'Malliha Wilson served as Assistant Deputy Attorney General of the Government of Ontario & participated in over 20 notable cases at the Supreme Court.',
];

// Icons: Tabler Icons (MIT).
const strengths = [
  { label: 'Proven track record', icon: 'M8 21l8 0 M12 17l0 4 M7 4l10 0 M17 4v8a5 5 0 0 1 -10 0v-8 M5 9m-2 0a2 2 0 1 0 4 0a2 2 0 1 0 -4 0 M19 9m-2 0a2 2 0 1 0 4 0a2 2 0 1 0 -4 0' },
  { label: 'Proactive communication & transparency', icon: 'M8 9h8 M8 13h6 M18 4a3 3 0 0 1 3 3v8a3 3 0 0 1 -3 3h-5l-5 3v-3h-2a3 3 0 0 1 -3 -3v-8a3 3 0 0 1 3 -3h12z' },
  { label: 'Dedicated and tech-savvy staff', icon: 'M3 5a1 1 0 0 1 1 -1h16a1 1 0 0 1 1 1v10a1 1 0 0 1 -1 1h-16a1 1 0 0 1 -1 -1v-10z M7 20h10 M9 16v4 M15 16v4' },
  { label: 'Customized reports', icon: 'M14 3v4a1 1 0 0 0 1 1h4 M17 21h-10a2 2 0 0 1 -2 -2v-14a2 2 0 0 1 2 -2h7l5 5v11a2 2 0 0 1 -2 2z M9 17l0 -5 M12 17l0 -1 M15 17l0 -3' },
  { label: 'Competitive prices', icon: 'M7 7m-4 0a4 4 0 1 0 8 0a4 4 0 1 0 -8 0 M3 21v-2a4 4 0 0 1 4 -4h4 M16 15h-2.5a1.5 1.5 0 0 0 0 3h1a1.5 1.5 0 0 1 0 3h-2.5 M15 21v1m0 -8v1' },
];
---

<section class="section">
  <div class="container">
    <h2 class="title">About<span>Us</span></h2>
    <div class="grid">
      <ul class="facts">{facts.map((f) => <li>{f}</li>)}</ul>
      <ul class="strengths">
        {strengths.map((s) => (
          <li>
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={s.icon} /></svg>
            {s.label}
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 48px;
    margin-top: 48px;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .facts li {
    position: relative;
    padding-left: 18px;
    font-size: var(--fs-body);
  }

  .facts li + li {
    margin-top: 20px;
  }

  .facts li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-primary);
  }

  .strengths li {
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: 18px;
    font-weight: 600;
    color: var(--color-heading);
  }

  .strengths li + li {
    margin-top: 14px;
  }

  .strengths svg {
    flex: none;
    color: var(--color-heading);
  }

  @media (max-width: 767px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
    }
    .strengths li {
      font-size: 16px;
    }
  }
</style>

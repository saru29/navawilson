---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const team = await getCollection('team');
  return team.map((member) => ({ params: { slug: member.id }, props: { member } }));
}

const { member } = Astro.props;
const { Content } = await render(member);
const { name, role, photo, description } = member.data;
---

<BaseLayout title={`${name} | Nava Wilson`} description={description}>
  <main class="section">
    <div class="container profile">
      {photo && <img src={photo} alt={name} width="510" height="465" />}
      <div>
        <a href="/about-us/" class="back">← Our team</a>
        <h1>{name}</h1>
        {role && <p class="role">{role}</p>}
        <div class="prose"><Content /></div>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .profile {
    display: grid;
    grid-template-columns: minmax(0, 360px) minmax(0, 1fr);
    gap: 48px;
    align-items: start;
  }

  img {
    border-radius: var(--radius-card);
  }

  .back {
    font-size: 14px;
    font-weight: 500;
    color: var(--color-primary);
    text-decoration: none;
  }

  h1 {
    margin-top: 12px;
    font-size: var(--fs-h2);
  }

  .role {
    margin: 4px 0 24px;
    color: var(--color-text-muted);
  }

  @media (max-width: 767px) {
    .profile {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

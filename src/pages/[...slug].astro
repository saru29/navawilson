---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Blocks from '../components/elementor/Blocks.astro';
import { formatDate } from '../lib/format';
import '../styles/elementor.css';

// Blog posts and imported pages live at the site root, matching the WordPress URLs.
export async function getStaticPaths() {
  const collections = await Promise.all([getCollection('blog'), getCollection('pages'), getCollection('layouts')]);
  return collections.flat().map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const data = entry.data;
const title = data.seoTitle ?? `${data.title} | Nava Wilson`;
const isPost = entry.collection === 'blog';
const Content = entry.collection === 'layouts' ? null : (await render(entry)).Content;
---

<BaseLayout
  title={title}
  description={data.description}
  image={entry.collection === 'blog' ? entry.data.image : undefined}
  type={isPost ? 'article' : 'website'}
>
  {entry.collection === 'layouts' ? (
    <main class="el-page"><Blocks items={entry.data.sections} top /></main>
  ) : (
    <main>
      <header class="banner">
        <div class="container">
          {isPost && <a href="/blogs/" class="back">← All articles</a>}
          <h1>{('heading' in data && data.heading) || data.title}</h1>
          {entry.collection === 'blog' && (
            <p class="meta">
              <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time>
              {entry.data.categories.length > 0 && <> · {entry.data.categories.join(', ')}</>}
            </p>
          )}
        </div>
      </header>
      <article class="section">
        <div class="container">
          <div class="prose">{Content && <Content />}</div>
        </div>
      </article>
    </main>
  )}
</BaseLayout>

<style>
  .banner {
    padding-block: 56px;
    background: linear-gradient(#d4d4db, #f1f2fa);
  }

  h1 {
    max-width: 860px;
    font-size: var(--fs-h1);
  }

  .back {
    display: inline-block;
    margin-bottom: 16px;
    font-size: 14px;
    font-weight: 500;
    color: var(--color-primary);
    text-decoration: none;
  }

  .meta {
    margin-top: 16px;
    font-size: 14px;
    color: var(--color-text-muted);
  }
</style>
